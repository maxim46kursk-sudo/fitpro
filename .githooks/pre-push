#!/bin/sh
# Пуш без прогона в WebKit невозможен.
#
# Корневая причина аварии 19.08 — не код судейства, а то, что проверки под
# движком Apple у нас не было вовсе: все прогоны ходили через chromium, хотя оба
# браузера на iPhone — WebKit. Поломка доехала до людей, потому что её негде
# было поймать. Поэтому прогон стоит здесь, до отправки, а не в списке добрых
# намерений.
#
# Хук ставится сам после npm install (scripts/install-hooks.mjs через prepare),
# чтобы не потеряться при следующем клоне.
#
# Обойти можно только осознанно: git push --no-verify.
echo "pre-push: прогон в WebKit"
npm run check:webkit || {
  echo ""
  echo "ПУШ ОСТАНОВЛЕН: прогон в WebKit не прошёл."
  echo "Чинить, а не обходить: именно эта дыра положила прод на iPhone."
  exit 1
}
