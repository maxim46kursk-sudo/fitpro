# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment variables (API keys)
.env
.env.*
.env.local
.env.*.local
*.env.txt

# Local MCP server config (machine-specific tool access, not app code)
.mcp.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Дампы env (содержат service_role) — только локально, никогда в git
vercel-env*.txt
env-new*

# Скриншоты и отчёт сквозного прогона (qa/run.mjs). Сотни картинок с прода,
# снятых под тестовыми аккаунтами, — смотреть локально, в историю не класть.
qa-screens/

# Артефакты скриптов (сгенерированные иконки, кэш Python) — не код
scripts/__pycache__/
scripts/out/
*.pyc

# Рабочие заметки и выгрузки для передачи контекста — не код проекта.
# Живут локально, в репозиторий не идут (в т.ч. потому, что security-разборы
# содержат описания слабых мест, которым в публичной истории не место).
fitpro_export.md
fitpro_handoff.md
fitpro_security_2.md
fitpro_security_3.md

# Скриншоты проверок вёрстки (qa/confirm-card.html) — артефакты прогона,
# в репозитории им делать нечего.
qa/shots/

# Фотографии товаров для прогонов (qa/photos) — бинарники, качаются скриптом.
qa/photos/
qa/_pool*.json
qa/_codes.json

# Манифест отката импорта OFF (scripts/off-upload.mjs) — снимок ПРЕЖНИХ строк
# боевой базы. В репозиторий ему нельзя: это данные прода, а не код.
scripts/off-import-manifest.json
